PORT=4000
NODE_ENV=development

# Odoo (mismo formato que tu app actual)
ODOO_URL=https://TUINSTANCIA.dev.odoo.com
ODOO_DB=TU_DB
ODOO_USERNAME=sistemas@tuempresa.com
ODOO_PASSWORD=TU_API_KEY_O_PASSWORD
ODOO_COMPANY_ID=1

# Nombre de lista de precios cliente final
ODOO_CUSTOMER_PRICELIST_NAME="Predeterminado (ARS)"

# SOLO DEV (por el cert en *.dev.odoo.com)
ALLOW_INSECURE_TLS=true

# Backend de Planificación Planta: al aceptar el cliente el presupuesto final,
# se crea el portón ahí automáticamente (POST /portones) con fecha_prod =
# fecha de aceptación. Si el host de Planta cambia, actualizar acá.
PLANTA_API_BASE=https://planificacion-uprm.onrender.com
